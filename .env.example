# ─────────────────────────────────────────────
# 필수: Anthropic Claude API
# https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 모델 (기본값: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────
# 선택: 실시간 웹 검색 공급자 (하나 이상 권장)
# 아무것도 없으면 Claude 내장 web_search 도구 → LLM 사전지식 순으로 폴백합니다.
# ─────────────────────────────────────────────
# 1순위: Tavily  (https://app.tavily.com)
TAVILY_API_KEY=

# 2순위: Serper.dev (Google SERP)  (https://serper.dev)
SERPER_API_KEY=

# 3순위: Perplexity  (https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=

# 검색 공급자 강제 지정: tavily | serper | perplexity | native | auto (기본 auto)
SEARCH_PROVIDER=auto
